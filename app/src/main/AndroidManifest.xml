<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />


    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppBaseTheme"
        android:name="com.ikartehfox.pendulumstudio.PSApplication" >
        <activity
            android:name="com.ikartehfox.pendulumstudio.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".mathematicalpendulum.MPGLActivity"
            android:label="@string/mp"
            android:logo="@drawable/ic_mp_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".mathematicalpendulum.MPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".pendulumwave.PWGLActivity"
            android:label="@string/pw"
            android:logo="@drawable/ic_pw_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".pendulumwave.PWParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".sphericalpendulum.SPGLActivity"
            android:label="@string/sp"
            android:logo="@drawable/ic_sp_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".sphericalpendulum.SPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".springpendulum2d.SP2DGLActivity"
            android:label="@string/sp2d"
            android:logo="@drawable/ic_sp2d_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".springpendulum2d.SP2DParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".springpendulum3d.SP3DGLActivity"
            android:label="@string/sp3d"
            android:logo="@drawable/ic_sp3d_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".springpendulum3d.SP3DParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".doublependulum.DPGLActivity"
            android:label="@string/dp"
            android:logo="@drawable/ic_dp_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".doublependulum.DPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".triplependulum.TPGLActivity"
            android:label="@string/tp"
            android:logo="@drawable/ic_tp_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".triplependulum.TPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".doublesphericalpendulum.DSPGLActivity"
            android:label="@string/dsp"
            android:logo="@drawable/ic_dsp_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".doublesphericalpendulum.DSPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".springmathematicalpendulum.SMPGLActivity"
            android:label="@string/smp"
            android:logo="@drawable/ic_smp_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".springmathematicalpendulum.SMPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <activity
            android:name=".springsphericalpendulum.SSPGLActivity"
            android:label="@string/ssp"
            android:logo="@drawable/ic_ssp3d_logo"
            android:theme="@style/AppTheme.GL" />
        <activity
            android:name=".springsphericalpendulum.SSPParametersActivity"
            android:theme="@style/AppTheme.Parameters"/>

        <service
            android:name=".livewallpaper.PendulumStudioWallpaperService"
            android:exported="true"
            android:label="@string/spherical_pendulum_wallpaper"
            android:permission="android.permission.BIND_WALLPAPER" >
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
        <activity
            android:name=".livewallpaper.WallpaperSettings"
            android:exported="true"
            android:label="@string/spherical_pendulum_wallpaper"
            android:theme="@style/WallpaperSettings" >
        </activity>

        <activity android:name=".SettingsActivity"
            android:theme="@style/AppBaseTheme" >
        </activity>

        <activity android:name=".InformationActivity"
            android:theme="@style/AppThemeNoTitle" >
        </activity>

    </application>

</manifest>
