<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle border behind a colour swatch so it stays visible against any
     background (e.g. a near-black pendulum colour on the dark theme). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="#59000000" />
    <solid
        android:color="#00000000" />
</shape>
